@model Alumno
@{
    ViewData["Title"] = "Matrícula confirmada";
}

<div class="confirmation-wrap">
    <div class="card confirmation-card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="success-mark" aria-hidden="true">✓</div>
            <span class="eyebrow">Registro completado</span>
            <h1 class="mt-2">¡Matrícula exitosa!</h1>
            <p class="text-secondary">El alumno fue incorporado correctamente al registro en memoria.</p>

            <dl class="row details-list mt-4 mb-0">
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Id)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Id)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Nombres)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Nombres)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Correo)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Correo)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Carrera)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Carrera)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Turno)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Turno)</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Becado)</dt>
                <dd class="col-sm-8">@(Model.Becado ? "Sí" : "No")</dd>
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Observaciones)</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Sin observaciones" : Html.DisplayFor(m => m.Observaciones))</dd>
            </dl>

            <div class="d-flex flex-column flex-sm-row gap-3 mt-5">
                <a class="btn btn-primary" href="@Url.Action("Create")">Crear otra matrícula</a>
                <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Regresar al listado</a>
            </div>
        </div>
    </div>
</div>
